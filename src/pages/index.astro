---
import "../styles/global.css";
import { getAssets } from "../lib/assets";

const assets = getAssets();
const featuredAssets = assets;

const categoryBlueprints = [
  { name: "Personagens", key: "personagens", description: "Sprites, personagens direcionais e animações para gameplay.", icon: "CHAR" },
  { name: "Construções", key: "construções", description: "Prédios, atrações e estruturas pré-renderizadas.", icon: "BLDG" },
  { name: "Vegetação", key: "vegetação", description: "Árvores, arbustos e elementos naturais prontos para cenário.", icon: "NAT" },
  { name: "Tiles & Terreno", key: "tiles", description: "Pisos, caminhos, terreno e módulos para mapas.", icon: "TILE" },
  { name: "Props", key: "props", description: "Objetos de cena, decoração e elementos utilitários.", icon: "PROP" },
  { name: "UI & Ícones", key: "ui", description: "Ícones e elementos visuais para interfaces de jogo.", icon: "UI" },
];

const normalize = (value: string) => value.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLocaleLowerCase("pt-BR");
const categories = categoryBlueprints.map((category) => ({
  ...category,
  count: assets.filter((asset) => {
    const haystack = [asset.category, ...(asset.tags ?? [])].map(normalize).join(" ");
    return haystack.includes(normalize(category.key));
  }).length,
}));
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Assets originais para jogos produzidos com ferramentas procedurais da Softdown. Sprites, construções, vegetação, tiles e mais."
    />
    <meta name="theme-color" content="#0a0f14" />
    <title>Softdown Assets — Assets originais para jogos</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Pular para o conteúdo</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Softdown Assets — início">
          <span class="brand-mark" aria-hidden="true">S</span>
          <span class="brand-text">Softdown <strong>Assets</strong></span>
        </a>
        <nav class="nav" aria-label="Navegação principal">
          <a href="#categorias">Categorias</a>
          <a href="#assets">Assets</a>
          <a href="#processo">Como funciona</a>
          <a href="/sobre-nos/">Sobre nós</a>
          <a href="#license">Licença</a>
        </nav>
        <details class="mobile-menu"><summary>Menu</summary><nav aria-label="Navegação mobile"><a href="#categorias">Categorias</a><a href="#assets">Assets</a><a href="#processo">Como funciona</a><a href="/sobre-nos/">Sobre nós</a><a href="#license">Licença</a></nav></details>
        <a class="header-cta" href="#assets">Explorar biblioteca</a>
      </div>
    </header>

    <main id="main-content">
      <section class="hero">
        <div class="hero-copy">
          <div class="eyebrow"><span></span> Game assets originais</div>
          <h1>Assets prontos para entrar no seu jogo.</h1>
          <p class="hero-lead">
            Sprites, construções, vegetação, tiles e props produzidos com ferramentas procedurais próprias da Softdown — organizados para uso real em desenvolvimento de jogos.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#assets">Explorar assets</a>
            <a class="button button-secondary" href="#processo">Conhecer o processo</a>
          </div>
          <div class="hero-notes" aria-label="Características do catálogo">
            <span>PNG transparente</span>
            <span>Informações técnicas</span>
            <span>Download direto</span>
          </div>
        </div>

        <div class="hero-stage" aria-hidden="true">
          <div class="stage-grid"></div>
          <div class="stage-card stage-card-main">
            <div class="stage-topline">
              <span class="stage-badge">ASSET READY</span>
              <span class="stage-dots">•••</span>
            </div>
            <div class="stage-asset">
              <div class="isometric-diamond diamond-back"></div>
              <div class="isometric-diamond diamond-mid"></div>
              <div class="asset-tree">
                <span class="tree-crown crown-one"></span>
                <span class="tree-crown crown-two"></span>
                <span class="tree-crown crown-three"></span>
                <span class="tree-trunk"></span>
              </div>
            </div>
            <div class="stage-footer">
              <div>
                <small>PIPELINE</small>
                <strong>Softdown Procedural</strong>
              </div>
              <span>PNG · 4 DIR</span>
            </div>
          </div>
          <div class="stage-card stage-card-small stage-card-left"><span>2D</span><strong>Sprites</strong></div>
          <div class="stage-card stage-card-small stage-card-right"><span>3D → 2D</span><strong>Pre-render</strong></div>
        </div>
      </section>

      <section class="home-section" id="categorias">
        <div class="section-heading">
          <div>
            <div class="section-kicker">Biblioteca organizada</div>
            <h2>Encontre pelo tipo de asset.</h2>
          </div>
          <p>Categorias pensadas para quem precisa montar um jogo, não apenas colecionar imagens.</p>
        </div>

        <div class="category-grid">
          {categories.map((category) => (
            <a class="category-card" href="#assets" data-category={normalize(category.key)}>
              <div class="category-icon" aria-hidden="true">{category.icon}</div>
              <div class="category-content">
                <div class="category-title-row">
                  <h3>{category.name}</h3>
                  <span>{category.count > 0 ? `${category.count} ${category.count === 1 ? "disponível" : "disponíveis"}` : "Em preparação"}</span>
                </div>
                <p>{category.description}</p>
              </div>
              <span class="category-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>

      <section class="home-section library-section" id="assets">
        <div class="section-heading">
          <div>
            <div class="section-kicker">Seleção Softdown</div>
            <h2>Explore a biblioteca.</h2>
          </div>
          <p>{assets.length} asset{assets.length === 1 ? "" : "s"} publicado{assets.length === 1 ? "" : "s"} no catálogo.</p>
        </div>

        {assets.length > 0 && <form class="catalog-controls" role="search"><label for="asset-search">Buscar assets<input id="asset-search" type="search" placeholder="Nome, categoria ou tag" /></label><label for="asset-category">Categoria<select id="asset-category"><option value="">Todas as categorias</option>{categories.map(category => <option value={normalize(category.key)}>{category.name}</option>)}</select></label><button class="button button-secondary" type="reset">Limpar filtros</button></form>}
        <p id="filter-status" role="status" hidden></p>
        {featuredAssets.length === 0 ? (
          <div class="catalog-empty">
            <div class="catalog-empty-visual">
              <span class="empty-orbit orbit-one"></span>
              <span class="empty-orbit orbit-two"></span>
              <span class="empty-core">S</span>
            </div>
            <div>
              <div class="section-kicker">Curadoria em andamento</div>
              <h3>O catálogo está sendo preparado.</h3>
              <p>
                Estamos selecionando os primeiros pacotes. Cada asset terá preview, especificações e arquivos organizados antes de aparecer aqui.
              </p>
            </div>
          </div>
        ) : (
          <div class="grid asset-grid-home">
            {featuredAssets.map((asset) => (
              <a class="card" href={`/assets/${asset.slug}/`} data-search={normalize([asset.title, asset.category, ...asset.tags].join(" "))} data-category={normalize([asset.category, ...asset.tags].join(" "))}>
                <div class="card-image"><img src={asset.preview} alt={asset.title} loading="lazy" decoding="async" /></div>
                <div class="card-body">
                  <div class="category">{asset.category}</div>
                  <h3>{asset.title}</h3>
                  <div class="meta">
                    {asset.width && asset.height ? `${asset.width}×${asset.height} · ` : ""}
                    {asset.format}
                    {asset.directions ? ` · ${asset.directions} ${asset.directions === 1 ? "direção" : "direções"}` : ""}
                  </div>
                </div>
              </a>
            ))}
          </div>
        )}
      </section>

      <section class="home-section process-section" id="processo">
        <div class="process-intro">
          <div class="section-kicker">Produção própria</div>
          <h2>Da criação ao pacote pronto.</h2>
          <p>
            Nossas ferramentas nasceram durante o desenvolvimento de jogos. Cada pacote é revisado para manter câmera, escala, direções e transparência consistentes.
          </p>
        </div>

        <div class="process-grid">
          <article class="process-card">
            <span class="process-number">01</span>
            <h3>Gerado</h3>
            <p>O asset nasce de receitas e ferramentas procedurais próprias.</p>
          </article>
          <article class="process-card">
            <span class="process-number">02</span>
            <h3>Validado</h3>
            <p>Direção, escala, transparência e estrutura são verificadas antes da publicação.</p>
          </article>
          <article class="process-card">
            <span class="process-number">03</span>
            <h3>Empacotado</h3>
            <p>Preview, arquivos finais e informações técnicas ficam organizados para download.</p>
          </article>
        </div>
      </section>

      <section class="home-section license-panel" id="license">
        <div>
          <div class="section-kicker">Uso simples</div>
          <h2>Baixe, entenda o pacote e use no seu projeto.</h2>
          <p>
            Cada página mostra formato, resolução, direções, transparência e demais informações relevantes antes do download. Os assets deste catálogo são distribuídos gratuitamente; cada pacote informa as condições de uso aplicáveis.
          </p>
        </div>
        <div class="license-points">
          <span><strong>01</strong> Preview claro</span>
          <span><strong>02</strong> Especificação técnica</span>
          <span><strong>03</strong> Pacote organizado</span>
        </div>
      </section>

      <section class="final-cta">
        <div>
          <div class="section-kicker">Softdown Assets</div>
          <h2>Uma biblioteca feita para entrar no pipeline do jogo.</h2>
        </div>
        <a class="button button-primary" href="#assets">Ver biblioteca</a>
      </section>
    </main>

    <footer>
      <div class="footer-inner">
        <div>
          <a class="brand footer-brand" href="/">
            <span class="brand-mark">S</span>
            <span class="brand-text">Softdown <strong>Assets</strong></span>
          </a>
          <p>Assets gratuitos originais produzidos com ferramentas procedurais Softdown.</p>
        </div>
        <div class="footer-meta">
          <span>© {new Date().getFullYear()} Softdown Assets</span>
          <a href="/sobre-nos/">Sobre nós</a>
          <a href="#license">Licença</a>
          <a href="#categorias">Categorias</a>
        </div>
      </div>
    </footer>
    <script>
      const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");
      if (!motionPreference.matches && "IntersectionObserver" in window) {
        const groups = document.querySelectorAll<HTMLElement>(".category-grid, .asset-grid-home, .process-grid");
        const reveal = (group: HTMLElement) => {
          group.querySelectorAll<HTMLElement>(".reveal-pending").forEach(card => {
            card.classList.remove("reveal-pending");
            card.classList.add("reveal-visible");
          });
        };
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            reveal(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          });
        }, { threshold: 0, rootMargin: "0px 0px -32px 0px" });
        groups.forEach(group => {
          Array.from(group.children).forEach((child, index) => {
            const card = child as HTMLElement;
            card.style.setProperty("--reveal-delay", `${Math.min(index, 5) * 90}ms`);
            card.classList.add("reveal-pending");
            card.addEventListener("focusin", () => reveal(group));
          });
          observer.observe(group);
        });
        motionPreference.addEventListener("change", () => {
          if (!motionPreference.matches) return;
          groups.forEach(reveal);
          observer.disconnect();
        });
      }
      const normalize = (value: string) => value.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLocaleLowerCase("pt-BR");
      const search = document.querySelector<HTMLInputElement>("#asset-search");
      const category = document.querySelector<HTMLSelectElement>("#asset-category");
      const status = document.querySelector<HTMLElement>("#filter-status");
      const cards = Array.from(document.querySelectorAll<HTMLElement>(".card[data-search]"));
      function filterAssets() {
        if (!search || !category || !status) return;
        const terms = normalize(search.value).trim().split(/\s+/).filter(Boolean);
        let visible = 0;
        cards.forEach(card => {
          card.hidden = !terms.every(term => card.dataset.search?.includes(term)) || !card.dataset.category?.includes(category.value);
          if (!card.hidden) visible++;
        });
        status.hidden = false;
        status.textContent = visible ? `${visible} ${visible === 1 ? "asset encontrado" : "assets encontrados"}.` : "Nenhum asset encontrado. Tente outra busca ou limpe os filtros.";
      }
      search?.addEventListener("input", filterAssets);
      category?.addEventListener("change", filterAssets);
      document.querySelector(".catalog-controls")?.addEventListener("submit", event => event.preventDefault());
      document.querySelector(".catalog-controls")?.addEventListener("reset", () => { if (search && category) { search.value = ""; category.value = ""; filterAssets(); } });
      document.querySelectorAll<HTMLElement>(".category-card").forEach(link => link.addEventListener("click", () => {
        if (category) { category.value = link.dataset.category ?? ""; filterAssets(); }
      }));
      document.querySelectorAll(".mobile-menu a").forEach(link => link.addEventListener("click", () => document.querySelector(".mobile-menu")?.removeAttribute("open")));
    </script>
  </body>
</html>
